# Activate hardened configuration. Copy this file to your secret manager or deployment environment.
SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:mysql://db.example.internal:3306/bilibili?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
SPRING_DATASOURCE_USERNAME=replace_me
SPRING_DATASOURCE_PASSWORD=replace_me

SPRING_DATA_REDIS_HOST=redis.example.internal
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace_me

SPRING_CLOUD_NACOS_DISCOVERY_SERVER_ADDR=nacos.example.internal:8848
SPRING_CLOUD_NACOS_USERNAME=replace_me
SPRING_CLOUD_NACOS_PASSWORD=replace_me

ROCKETMQ_NAME_SERVER=rocketmq.example.internal:9876
SPRING_ELASTICSEARCH_URIS=https://elasticsearch.example.internal:9200

MINIO_ENDPOINT=https://minio.example.internal
MINIO_PUBLIC_ENDPOINT=https://media.example.com
MINIO_ACCESS_KEY=replace_me
MINIO_SECRET_KEY=replace_me

CANAL_SERVER_HOST=canal.example.internal
CANAL_SERVER_PORT=11111
CANAL_USERNAME=replace_me
CANAL_PASSWORD=replace_me
DANMU_WEBSOCKET_URI=ws://bilibili-danmu-service:8093
# Operations API (generate a long random value; never commit the real token)
OPERATIONS_ADMIN_TOKEN=replace-with-a-long-random-token

# Authentication: short-lived access token and rotated HttpOnly refresh cookie
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_COOKIE_NAME=bili_refresh
AUTH_REFRESH_COOKIE_PATH=/api/user
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=Strict
DANMU_WEBSOCKET_TICKET_TTL_SECONDS=30

# Capacity baseline; tune against the production database and container limits
DATASOURCE_MAXIMUM_POOL_SIZE=30
DATASOURCE_MINIMUM_IDLE=5
REDIS_POOL_MAX_ACTIVE=32
REDIS_POOL_MAX_IDLE=16
REDIS_POOL_MIN_IDLE=4
APPLICATION_TASK_CORE_SIZE=8
APPLICATION_TASK_MAX_SIZE=32
SERVER_TOMCAT_THREADS_MAX=200
GATEWAY_MAX_CONNECTIONS=500
# Enable only when the gateway is reachable exclusively through Nginx or another trusted proxy.
GATEWAY_RATE_LIMIT_TRUST_FORWARDED_FOR=true
GATEWAY_AUTH_RATE=5
GATEWAY_AUTH_BURST=10
GATEWAY_REFRESH_RATE=50
GATEWAY_REFRESH_BURST=100
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1

# Reliable event delivery: Outbox producer + Inbox consumer
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=100
OUTBOX_RECLAIM_SECONDS=60
OUTBOX_RETRY_SECONDS=2
OUTBOX_DISPATCH_INTERVAL=500
MQ_CONSUME_MAX_ATTEMPTS=3
MQ_INBOX_LEASE_SECONDS=60
MQ_RETHROW_AFTER_FAILURE=true
# Browser origins allowed to use presigned object-storage uploads.
MINIO_CORS_ALLOW_ORIGIN=https://video.example.com
CDN_BASE_URL=https://cdn.video.example.com
MINIO_TEMP_LIFECYCLE_DAYS=1
MINIO_SOURCE_LIFECYCLE_DAYS=30
